# Supabase — trovi questi valori in Project Settings > API sul tuo progetto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel Blob — storage per gli mp3 (10GB gratis, upload diretto dal browser).
# Crea uno store da Vercel → progetto → tab "Storage" → "Create Database" → Blob:
# la variabile viene aggiunta in automatico al progetto deployato. Per lo sviluppo
# locale copiala da lì, oppure lancia `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Password per accedere al pannello Master (organizzatore)
MASTER_PASSWORD=cambiami-subito

# Segreto usato per firmare i cookie di sessione (giurati + master).
# Genera un valore casuale robusto, es: openssl rand -base64 32
SESSION_SECRET=cambiami-con-un-valore-casuale-lungo
